# Copy the values into your shell session; do not store Apple passwords here.
export AGENT_ISLAND_DEVELOPER_ID_APPLICATION="Developer ID Application: YOUR LEGAL NAME (TEAMID)"
export AGENT_ISLAND_NOTARY_KEYCHAIN_PROFILE="agentisland-notary"
# These identifiers must copy the values already applied and frozen by a
# schemaVersion 2 Config/ReleaseIdentity.json + .release/identity.lock.json.
# AGENT_ISLAND_BUNDLE_ID is the locked macOSAppBundleIdentifier. Do not point
# it at the iOS identifier when using separate App Store records.
export AGENT_ISLAND_BUNDLE_ID="com.yourname.agentisland"
export AGENT_ISLAND_IOS_BUNDLE_ID="com.yourname.agentisland"
export AGENT_ISLAND_IOS_WIDGET_BUNDLE_ID="com.yourname.agentisland.liveactivity"
export AGENT_ISLAND_DEVELOPMENT_TEAM="YOURTEAMID"
export AGENT_ISLAND_ICLOUD_CONTAINER_ID="iCloud.com.yourname.agentisland"
# Public display name. Verify store and trademark availability before a formal
# release. This changes CFBundleDisplayName, not legacy internal identifiers.
export AGENT_ISLAND_DISPLAY_NAME="MAC版灵动岛--Agent运行监测"
export AGENT_ISLAND_VERSION="0.6.1"
export AGENT_ISLAND_BUILD_NUMBER="8"

# Exact TestFlight evidence created by confirm-testflight-evidence.sh after the
# upload was accepted, App Store Connect processing and every warning were
# reviewed, the build was distributed, and that same build was installed from
# TestFlight on a device.
export AGENT_ISLAND_IOS_TESTFLIGHT_VERIFICATION_EVIDENCE="$PWD/dist/ios/<version-build-timestamp>/testflight-verification-<timestamp>.json"
# Read-only, no-overwrite record produced by confirm-functional-qa-evidence.sh after four
# distinct attachments document Production CloudKit schema, same-account
# Mac-to-iPhone sync, Live Activity, and both review paths on this exact
# TestFlight installation. Readiness derives every QA boolean from this record;
# copied hashes and free-standing true/false switches are intentionally ignored.
export AGENT_ISLAND_IOS_FUNCTIONAL_QA_EVIDENCE="$PWD/dist/ios/<version-build-timestamp>/ios-functional-verification-<timestamp>.json"
# Repository-relative App Privacy evidence. Readiness does not accept this as
# one global checkbox: its iOS entry must match the exact IPA's platform,
# bundle/version/build and SHA-256; its macOS entry must independently match
# the exact exported App Store package (or the Archive ZIP when no package was
# exported yet). Universal Purchase needs one evidence record covering both
# candidates. Separate App Store records may use independent macOS/iOS evidence
# files so one platform can pass without the other candidate being complete.
export AGENT_ISLAND_APP_PRIVACY_EVIDENCE=".release/app-privacy-evidence.json"

# Sealed App Store submission decisions and a fresh, submission-bound snapshot
# of the public privacy/support pages. Generate both explicitly before final
# review; release-readiness.sh only verifies these files offline.
export AGENT_ISLAND_APP_STORE_SUBMISSION=".release/app-store-submission.json"
export AGENT_ISLAND_PUBLIC_PAGES_EVIDENCE=".release/public-pages-evidence.json"

# Fresh read-only App Store Connect Build snapshots for the exact Mac and iOS
# candidates. Capture them manually while online, then let readiness consume
# only these paths in offline --verify mode. Keep API credentials outside this
# file. Apple snapshots expire after at most 900 seconds.
export AGENT_ISLAND_ASC_MAC_BUILD_SNAPSHOT="$PWD/dist/macos-app-store/<version-build-timestamp>/asc-build-snapshot.json"
export AGENT_ISLAND_ASC_IOS_BUILD_SNAPSHOT="$PWD/dist/ios/<version-build-timestamp>/asc-build-snapshot.json"
export AGENT_ISLAND_ASC_SNAPSHOT_MAX_AGE_SECONDS="900"

# Mac App Store target and identity-lock v2 record model. Keep the paths pointed
# at the one macOS application target that will actually be archived. This mode
# must exactly equal the locked appStoreRecordMode: universal-purchase requires
# the locked macOS/iOS App IDs to match; separate-records requires them to be
# different and uses two App Store Connect records. Changing the mode or either
# ID requires an explicitly reviewed identity migration, not an env override.
export AGENT_ISLAND_MAC_APP_STORE_PROJECT="$PWD/ApplePlatforms/macOS/AgentIslandMac.xcodeproj"
export AGENT_ISLAND_MAC_APP_STORE_SCHEME="AgentIslandMac"
export AGENT_ISLAND_APP_STORE_RECORD_MODE="universal-purchase"

# Exact-build Mac App Store evidence chain. release-metadata.json remains the
# local source for one exported candidate; readiness re-hashes its Archive ZIP
# and PKG and reruns submit-macos-app-store.sh --check.
export AGENT_ISLAND_MAC_APP_STORE_RELEASE_METADATA="$PWD/dist/macos-app-store/<version-build-timestamp>/release-metadata.json"
# Created only after all five checks and five distinct attachments have been
# recorded for that exact Archive ZIP + PKG. The validator derives the five QA
# booleans; copied hashes and free-standing true/false switches are ignored.
export AGENT_ISLAND_MAC_APP_STORE_FUNCTIONAL_QA_EVIDENCE="$PWD/dist/macos-app-store/<version-build-timestamp>/macos-functional-verification-<timestamp>.json"
# Set only after an explicit --upload produced this no-overwrite, read-only
# delivery record and its validation/upload response files. Upload acceptance
# is not Apple processing completion and is not App Review submission.
export AGENT_ISLAND_MAC_APP_STORE_DELIVERY_EVIDENCE="$PWD/dist/macos-app-store/<version-build-timestamp>/mac-app-store-delivery-<timestamp>.json"
# Set only after a person inspected the same build in App Store Connect,
# confirmed processingState=Complete, reviewed every warning, and generated the
# local processing record. This is operator evidence; the validator does not
# re-query Apple, select the build for a version, or submit it for App Review.
export AGENT_ISLAND_MAC_APP_STORE_PROCESSING_EVIDENCE="$PWD/dist/macos-app-store/<version-build-timestamp>/mac-app-store-processing-verification-<timestamp>.json"

# Public production HTTPS pages shown from Settings. Both are mandatory for
# release-macos.sh. Leave unset in development; the app then displays a
# release-configuration notice instead of opening a placeholder URL.
export AGENT_ISLAND_PRIVACY_POLICY_URL="https://kiki-lgtm-dot.github.io/mac-agent-monitor-app/privacy/"
export AGENT_ISLAND_SUPPORT_URL="https://kiki-lgtm-dot.github.io/mac-agent-monitor-app/support/"

# Required for the CloudKit release. First use apply-release-identity.sh with
# the signed Developer ID provisioning profile. It derives the authoritative
# App ID prefix from that profile and writes final entitlements only after the
# App ID, Team and sole Production CloudKit container all match. Do not assume
# the App ID prefix equals the Team ID and do not put credentials in the
# release identity JSON or lock.
# export AGENT_ISLAND_ENTITLEMENTS="$PWD/.release/CloudKit.entitlements"
# export AGENT_ISLAND_PROVISIONING_PROFILE="/absolute/path/AgentIsland_Developer_ID.provisionprofile"
